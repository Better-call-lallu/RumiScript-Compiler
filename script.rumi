print("Lets go with RumiScript");

print("--- Basic Math & Input ---");
set x = 10;
print("x is set to: ", x);

print("Enter a number for y (Try an integer, float, or 0!):");
scan(y);

set sum = x + y;
print("The sum of x and y is: ", sum);

print("--- Division ---");
set div = x / y;
print("x divided by y is: ", div);

print("--- Math Functions ---");
set z = -25.5; 
set abs_z = abs(z);
print("Absolute value of ", z, " is: ", abs_z);

set a = 3;
set b = 8;
set power = pow(a, 2);
set maximum = max(a, b);
set minimum = min(a, b);

print(a, " to the power of 2 is: ", power);
print("Max of ", a, " and ", b, " is: ", maximum);
print("Min of ", a, " and ", b, " is: ", minimum);

print("--- Conditionals ---");
if (sum > 50) {
    print("The sum is greater than 50!");
} else {
    print("The sum is 50 or less.");
}

print("--- Repeat Loop ---");
repeat (5) {
    print("Meow");
}

print("--- For Loop ---");
print("Counting 1 to 10:");
for (set i = 1; i <= 10; set i = i + 1) {
    print(i);
}

print("=== Demonstration Complete ===");