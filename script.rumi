say("=== Welcome to RumiScript ===");

say("--- Testing Addition with User Input ---");
say("Enter the first number:");
ask(num1);

say("Enter the second number:");
ask(num2);

set sum = num1 + num2;
say("The sum of ", num1, " and ", num2, " is: ", sum);

say("--- Testing Control Flow & Loops ---");
when (sum > 20) {
    say("That's a pretty big sum!");
} otherwise {
    say("That sum is on the smaller side.");
}

repeat (2) {
    say("RumiScript handles math like a charm!");
}

set highest = max(sum, 100);
say("Max value between your sum and 100 is: ", highest);